{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "promptmaxxer",
  "version": "0.1.0",
  "identifier": "com.promptmaxxer.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../framework/system-prompt.md": "framework/system-prompt.md"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
